# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채우세요.  (cp .env.example .env)
# .env 는 절대 GitHub 에 올리지 마세요 (.gitignore 에 포함되어 있음).
# API 키를 Claude Code 채팅창에 붙여넣지 말고, 이 파일에 직접 입력하세요.

# --- Claude API (분석 agent 의 뉴스·공시 해석) : console.anthropic.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5

# --- 또는 Amazon Nova 2 Lite. Claude 키가 없으면 자동으로 Nova 사용
#   (1) nova.amazon.com 개발자 API 키 → NOVA_API_KEY (AWS_BEARER_TOKEN_BEDROCK 에 넣어도 자동 인식)
NOVA_API_KEY=
# NOVA_MODEL=nova-2-lite-v1
#   (2) AWS Bedrock
#     인증은 둘 중 하나: Bedrock API 키 또는 IAM 액세스 키
AWS_BEARER_TOKEN_BEDROCK=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# NOVA_MODEL_ID=global.amazon.nova-2-lite-v1:0
# BEDROCK_ENDPOINT_URL=      # 별도 엔드포인트 주소를 받았다면 (보통은 비움)
# LLM_PROVIDER=nova         # anthropic | nova | none (비우면 자동)

# --- 금융감독원 DART (공시) : opendart.fss.or.kr 에서 무료 발급
DART_API_KEY=

# --- 텔레그램 알림 (매수·매도 종목, 금액, 사유) : README '텔레그램 연결' 참고
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 한국투자증권 공식 샘플 코드 위치 (git clone 한 폴더 안의 examples_user)
#     앱키·계좌번호는 공식 방식대로 ~/KIS/config/kis_devlp.yaml 에 넣습니다.
KIS_OPEN_API_PATH=

# --- 브로커 선택: paper(내 PC 가상) | kis_demo(한국투자 모의투자) | kis_real(실전)
BROKER=paper

# --- 실전 주문 안전장치. 충분히 검증하기 전에는 절대 yes 로 바꾸지 마세요.
LIVE_TRADING=no
